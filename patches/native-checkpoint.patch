diff --git a/codex-rs/core/src/session/step_controller.rs b/codex-rs/core/src/session/step_controller.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cf91524aadbde7134a00a60331c593d8e786aba6
--- /dev/null
+++ b/codex-rs/core/src/session/step_controller.rs
@@ -0,0 +1,339 @@
+//! Opt-in evaluator bridge for every native CLI frontend. The bridge selects an
+//! effort; core applies it through the same live settings path as app-server.
+
+use std::sync::Arc;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use codex_features::Feature;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::openai_models::jev_base_model;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ReasoningEffortUpdatedEvent;
+use codex_protocol::protocol::TurnSettingsUpdate;
+use codex_protocol::protocol::TurnSettingsUpdateOutcome;
+use codex_protocol::user_input::UserInput;
+use serde::Deserialize;
+use serde::Serialize;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::net::UnixStream;
+
+use super::decision_context::DecisionContext;
+use super::decision_context::decision_context;
+use super::session::Session;
+use super::step_context::StepContext;
+use super::turn_context::TurnContext;
+
+pub(super) struct StepController {
+    connection: Option<UnixStream>,
+    sequence: u64,
+    failures: Arc<ToolFailureCounter>,
+    original_prompt: String,
+    latest_prompt: String,
+    input_revision: u64,
+    last_effort: Option<ReasoningEffort>,
+}
+
+#[derive(Default)]
+pub(crate) struct ToolFailureCounter(pub(crate) AtomicU64);
+
+pub(super) fn record_command_exit(turn: &TurnContext, exit_code: i32) {
+    if exit_code != 0
+        && let Some(counter) = turn.extension_data.get::<ToolFailureCounter>()
+    {
+        counter.0.fetch_add(1, Ordering::Release);
+    }
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Checkpoint {
+    protocol: u8,
+    r#type: &'static str,
+    thread_id: String,
+    turn_id: String,
+    step: u64,
+    model: String,
+    supported_efforts: Vec<ReasoningEffort>,
+    current_effort: Option<ReasoningEffort>,
+    input_revision: u64,
+    failed_tool_count: u64,
+    context: DecisionContext,
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase", deny_unknown_fields)]
+enum Reply {
+    Decision {
+        protocol: u8,
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        #[serde(rename = "turnId")]
+        turn_id: String,
+        step: u64,
+        effort: ReasoningEffort,
+        #[serde(rename = "leaseSteps")]
+        lease_steps: u32,
+        #[serde(rename = "evaluatorMs")]
+        evaluator_ms: u64,
+    },
+    Recorded {
+        protocol: u8,
+        step: u64,
+    },
+    Error {
+        message: String,
+    },
+}
+
+pub(super) struct AppliedSettings {
+    model: String,
+    previous_effort: Option<ReasoningEffort>,
+    effort: ReasoningEffort,
+    lease_steps: u32,
+    evaluator_ms: u64,
+}
+
+fn failure(message: impl Into<String>) -> CodexErr {
+    CodexErr::Fatal(format!("Jev bridge: {}", message.into()))
+}
+
+impl StepController {
+    pub(super) fn new(turn: &TurnContext, input: &[UserInput]) -> Self {
+        let mut controller = Self {
+            connection: None,
+            sequence: 0,
+            failures: turn.extension_data.get_or_init(ToolFailureCounter::default),
+            original_prompt: String::new(),
+            latest_prompt: String::new(),
+            input_revision: 0,
+            last_effort: None,
+        };
+        controller.accept_user_input(input);
+        controller
+            .original_prompt
+            .clone_from(&controller.latest_prompt);
+        controller
+    }
+
+    pub(super) fn accept_user_input(&mut self, input: &[UserInput]) {
+        if !input.is_empty() {
+            self.input_revision += 1;
+            self.latest_prompt = input
+                .iter()
+                .filter_map(|item| match item {
+                    UserInput::Text { text, .. } => Some(text.as_str()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>()
+                .join("\n");
+        }
+    }
+
+    async fn exchange(&mut self, message: &impl Serialize) -> Result<Reply> {
+        let data = serde_json::to_vec(message).map_err(|error| failure(error.to_string()))?;
+        if data.len() > 2_000_000 {
+            return Err(failure(
+                "context exceeds the 2 MB transport limit; no text was silently truncated",
+            ));
+        }
+        let connection = self
+            .connection
+            .as_mut()
+            .ok_or_else(|| failure("bridge is disconnected"))?;
+        let exchange = async {
+            connection.write_u32(data.len() as u32).await?;
+            connection.write_all(&data).await?;
+            let length = connection.read_u32().await? as usize;
+            if length == 0 || length > 4_096 {
+                return Err(std::io::Error::other("invalid evaluator reply length"));
+            }
+            let mut bytes = vec![0; length];
+            connection.read_exact(&mut bytes).await?;
+            Ok::<_, std::io::Error>(bytes)
+        };
+        let bytes = tokio::time::timeout(Duration::from_secs(40), exchange)
+            .await
+            .map_err(|_| failure("decision timeout"))?
+            .map_err(|error| failure(error.to_string()))?;
+        let reply: Reply =
+            serde_json::from_slice(&bytes).map_err(|_| failure("invalid evaluator reply"))?;
+        if let Reply::Error { message } = reply {
+            return Err(failure(message));
+        }
+        Ok(reply)
+    }
+
+    pub(super) async fn before_sampling(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+    ) -> Result<Option<AppliedSettings>> {
+        let current = turn.current_settings.load_full();
+        let selection = current.selected_collaboration_mode().model();
+        let Some(base_model) = jev_base_model(selection) else {
+            self.connection = None;
+            self.sequence = 0;
+            self.last_effort = None;
+            return Ok(None);
+        };
+        if !session.enabled(Feature::StepModelSwitching)
+            || !session.enabled(Feature::ReasoningEffortOverride)
+        {
+            return Err(failure(
+                "Jev requires native step_model_switching and reasoning_effort_override",
+            ));
+        }
+        let model = &current.model_info;
+        if model.slug != base_model
+            || model.used_fallback_model_metadata
+            || !model.use_responses_lite
+            || model.supported_reasoning_levels.is_empty()
+        {
+            return Err(failure(format!(
+                "{selection} requires available native {base_model} metadata with adaptive effort support; received {}.",
+                model.slug
+            )));
+        }
+        if self.connection.is_none() {
+            let socket = std::env::var_os("CODEX_STEP_CONTROLLER_SOCKET")
+                .ok_or_else(|| failure("Jev requires its bridge. Launch astra-ares."))?;
+            self.connection = Some(
+                tokio::time::timeout(Duration::from_secs(5), UnixStream::connect(socket))
+                    .await
+                    .map_err(|_| failure("connection timeout"))?
+                    .map_err(|error| failure(error.to_string()))?,
+            );
+        }
+        self.sequence += 1;
+        let context = {
+            let state = session.state.lock().await;
+            decision_context(
+                state.history.annotated_items(),
+                &self.original_prompt,
+                &self.latest_prompt,
+            )
+        };
+        let supported_efforts = model
+            .supported_reasoning_levels
+            .iter()
+            .map(|preset| preset.effort.clone())
+            .collect::<Vec<_>>();
+        let checkpoint = Checkpoint {
+            protocol: 3,
+            r#type: "checkpoint",
+            thread_id: session.thread_id().to_string(),
+            turn_id: turn.sub_id.clone(),
+            step: self.sequence,
+            model: model.slug.clone(),
+            supported_efforts: supported_efforts.clone(),
+            current_effort: current.reasoning_effort().cloned(),
+            input_revision: self.input_revision,
+            failed_tool_count: self.failures.0.load(Ordering::Acquire),
+            context,
+        };
+        let Reply::Decision {
+            protocol,
+            thread_id,
+            turn_id,
+            step,
+            effort,
+            lease_steps,
+            evaluator_ms,
+        } = self.exchange(&checkpoint).await?
+        else {
+            return Err(failure("expected an evaluator decision"));
+        };
+        if protocol != 3
+            || thread_id != checkpoint.thread_id
+            || turn_id != checkpoint.turn_id
+            || step != checkpoint.step
+            || !supported_efforts.contains(&effort)
+            || ![1, 2, 5, 10].contains(&lease_steps)
+        {
+            return Err(failure(
+                "decision does not match the active step or model capabilities",
+            ));
+        }
+        let latest = turn.current_settings.load_full();
+        if latest.model_info.slug != model.slug
+            || latest.selected_collaboration_mode().model() != selection
+        {
+            return Err(failure(
+                "model changed during evaluation; submit again to evaluate the selected model",
+            ));
+        }
+        match session
+            .apply_turn_settings(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    effort: Some(Some(effort.clone())),
+                    ..Default::default()
+                },
+            )
+            .await
+        {
+            TurnSettingsUpdateOutcome::Applied => {}
+            TurnSettingsUpdateOutcome::Rejected { reason } => return Err(failure(reason)),
+            TurnSettingsUpdateOutcome::TargetUnavailable => {
+                return Err(failure("active turn is unavailable"));
+            }
+        }
+        Ok(Some(AppliedSettings {
+            model: model.slug.clone(),
+            previous_effort: current.reasoning_effort().cloned(),
+            effort,
+            lease_steps,
+            evaluator_ms,
+        }))
+    }
+
+    pub(super) async fn confirm(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+        step: &StepContext,
+        applied: AppliedSettings,
+    ) -> Result<()> {
+        if step.settings.reasoning_effort() != Some(&applied.effort)
+            || step.settings.model_info.slug != applied.model
+            || jev_base_model(step.settings.selected_collaboration_mode().model())
+                != Some(applied.model.as_str())
+        {
+            return Err(failure(
+                "selected settings were not captured by the sampling step",
+            ));
+        }
+        let event = ReasoningEffortUpdatedEvent {
+            from_effort: applied
+                .previous_effort
+                .as_ref()
+                .filter(|effort| *effort != &applied.effort)
+                .map(ToString::to_string),
+            to_effort: applied.effort.to_string(),
+            step: self.sequence,
+            lease_steps: applied.lease_steps,
+            evaluator_ms: applied.evaluator_ms,
+        };
+        let receipt = serde_json::json!({
+            "protocol": 3, "type": "applied", "threadId": session.thread_id().to_string(),
+            "turnId": turn.sub_id, "step": self.sequence, "effort": applied.effort,
+            "confirmation": "native_step_context_captured"
+        });
+        match self.exchange(&receipt).await? {
+            Reply::Recorded { protocol: 3, step } if step == self.sequence => {}
+            _ => return Err(failure("bridge did not record the native confirmation")),
+        }
+        if self.last_effort.is_none() || applied.previous_effort.as_ref() != Some(&applied.effort) {
+            session
+                .send_event(turn, EventMsg::ReasoningEffortUpdated(event))
+                .await;
+        }
