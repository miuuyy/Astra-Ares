+#[tokio::test]
+async fn jev_model_picker_selects_automatic_effort_without_fixed_effort_popup() {
+    for (alias, _, name) in codex_protocol::openai_models::JEV_MODELS {
+        let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.5")).await;
+        let mut preset = get_available_model(&chat, "gpt-5.5");
+        preset.id = alias.to_string();
+        preset.model = preset.id.clone();
+        preset.display_name = name.to_string();
+        preset.description = "Astra with automatic effort from Jev".to_string();
+        preset.is_default = false;
+        chat.open_model_popup_with_presets(vec![preset]);
+        let popup = render_bottom_popup(&chat, 90);
+        if alias == codex_protocol::openai_models::ASTRA_JEV_MODEL {
+            assert_chatwidget_snapshot!("jev_model_selection", popup);
+        }
+        assert!(popup.contains(name));
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+        while let Ok(event) = rx.try_recv() {
+            if let AppEvent::OpenReasoningPopup { model } = event {
+                chat.open_reasoning_popup(model);
+                break;
+            }
+        }
+        let mut selection = None;
+        while let Ok(event) = rx.try_recv() {
+            if let AppEvent::PersistModelSelection { model, effort } = event {
+                selection = Some((model, effort));
+            }
+        }
+        assert_eq!(selection, Some((alias.to_string(), None)));
+        assert!(!render_bottom_popup(&chat, 90).contains("Select Reasoning"));
+        assert_eq!(crate::model_catalog::model_display_name(alias), name);
+    }
+}
